rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar para verificar si el usuario es staff existente
    function isStaff() {
      return isAuthenticated() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Función para obtener el documento del staff actual
    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    // Función auxiliar para verificar si es Super Administrador
    function isSuperAdmin() {
      return isStaff() && getStaffData().role == 'SUPER_ADMIN';
    }

    // Función auxiliar para aislamiento multi-tenant
    function isSameTenant(docTenantId) {
      return isSuperAdmin() || (isStaff() && (getStaffData().tenantId == docTenantId || docTenantId == 'default_tenant'));
    }

    // Regla global segura por defecto: Cerrado
    match /{document=**} {
      allow read, write: if false; 
    }

    // TENANTS (INSTITUCIONES):
    match /tenants/{tenantId} {
      // Lectura para usuarios autenticados, gestión exclusiva de SuperAdmin
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // CONFIGURACIÓN DE TENANT:
    match /tenantSettings/{tenantId} {
      // Lectura para usuarios autenticados
      allow read: if isAuthenticated();
      // Escritura permitida para Administrador de Tenant, Recepción del mismo tenant o SuperAdmin
      allow write: if isSameTenant(tenantId) && (getStaffData().role == 'TENANT_ADMIN' || getStaffData().role == 'RECEPCION' || isSuperAdmin());
    }

    // STAFF (EQUIPO / PROFESIONALES):
    match /staff/{staffId} {
      // Lectura para el propio usuario o staff del mismo tenant
      allow read: if isAuthenticated() && (request.auth.uid == staffId || isSameTenant(resource.data.tenantId));
      // Creación y actualización controlada: solo SuperAdmin o Kine/Admin del mismo tenant.
      // Prohibido almacenar contraseñas en texto plano.
      allow create, update: if (isSuperAdmin() || (isSameTenant(request.resource.data.tenantId) && (getStaffData().role == 'TENANT_ADMIN' || getStaffData().role == 'KINE')))
        && (!('password' in request.resource.data) || request.resource.data.password == '');
      // Eliminación solo por SuperAdmin o Tenant Admin del mismo tenant
      allow delete: if isSuperAdmin() || (isSameTenant(resource.data.tenantId) && getStaffData().role == 'TENANT_ADMIN');
    }

    // PACIENTES:
    match /patients/{patientId} {
      // El paciente puede leer y actualizar su propio perfil (rutinas, etc.)
      allow read: if (isAuthenticated() && request.auth.uid == patientId) || isSameTenant(resource.data.tenantId);
      allow create: if isSameTenant(request.resource.data.tenantId);
      allow update: if (isAuthenticated() && request.auth.uid == patientId) || isSameTenant(request.resource.data.tenantId);
      allow delete: if isSameTenant(resource.data.tenantId);
    }

    // CITAS / TURNOS:
    match /appointments/{appId} {
      // El paciente puede ver sus citas; el staff ve las de su tenant
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isSameTenant(resource.data.tenantId));
      allow create, update: if isSameTenant(request.resource.data.tenantId);
      allow delete: if isSameTenant(resource.data.tenantId);
    }
    
    // CATÁLOGO DE EJERCICIOS:
    match /exercises/{exId} {
      // Catálogo consultable por todos los autenticados; edición solo Kinesiólogos, Tenant Admins o SuperAdmin
      allow read: if isAuthenticated();
      allow write: if isStaff() && (getStaffData().role == 'KINE' || getStaffData().role == 'TENANT_ADMIN' || isSuperAdmin());
    }

    // PRODUCTOS / SERVICIOS:
    match /products/{prodId} {
      // Catálogo visible a usuarios autenticados; gestión por staff del mismo tenant
      allow read: if isAuthenticated();
      allow create, update: if isSameTenant(request.resource.data.tenantId);
      allow delete: if isSameTenant(resource.data.tenantId);
    }
    
    // EVALUACIONES CLÍNICAS:
    match /clinical_evaluations/{evalId} {
      // El paciente puede consultar su historial; staff del mismo tenant gestiona
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSameTenant(resource.data.tenantId));
      allow create, update: if isSameTenant(request.resource.data.tenantId);
      allow delete: if isSameTenant(resource.data.tenantId);
    }

    // MOVIMIENTOS FINANCIEROS (INGRESOS, EGRESOS, CIERRES DE CAJA):
    match /financialMovements/{movId} {
      allow read, delete: if isSameTenant(resource.data.tenantId);
      allow create, update: if isSameTenant(request.resource.data.tenantId);
    }

    // CONTROL HORARIO (TIME LOGS / FICHAJES):
    match /timeLogs/{logId} {
      allow read, delete: if isSameTenant(resource.data.tenantId);
      allow create, update: if isSameTenant(request.resource.data.tenantId);
    }

    // INVENTARIO:
    match /inventory/{itemId} {
      allow read, delete: if isSameTenant(resource.data.tenantId);
      allow create, update: if isSameTenant(request.resource.data.tenantId);
    }

    // MOVIMIENTOS DE INVENTARIO:
    match /inventoryMovements/{movId} {
      allow read, delete: if isSameTenant(resource.data.tenantId);
      allow create, update: if isSameTenant(request.resource.data.tenantId);
    }

    // FACTURAS Y GASTOS (COMPRAS):
    match /purchaseInvoices/{invId} {
      allow read, delete: if isSameTenant(resource.data.tenantId);
      allow create, update: if isSameTenant(request.resource.data.tenantId);
    }
  }
}
